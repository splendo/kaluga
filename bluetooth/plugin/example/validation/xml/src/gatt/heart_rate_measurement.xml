<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the SIG Heart Rate Measurement (0x2A37) flags structure to exercise the complex codegen paths end to end:
     a leading flags byte that selects a field's width (uint8/uint16), carries an enum, and gates optional/repeated
     fields, plus a scaled repeated value. -->
<Characteristic type="org.example.characteristic.heart_rate_measurement" uuid="2A37" name="Heart Rate Measurement">
  <Value>
    <Field name="Flags">
      <Requirement>Mandatory</Requirement>
      <Format>8bit</Format>
      <BitField>
        <Bit index="0" size="1" name="Heart Rate Value Format bit">
          <Enumerations>
            <Enumeration key="0" value="Heart Rate value is a uint8" requires="C1" />
            <Enumeration key="1" value="Heart Rate value is a uint16" requires="C2" />
          </Enumerations>
        </Bit>
        <Bit index="1" size="2" name="Sensor Contact Status bits">
          <Enumerations>
            <Enumeration key="0" value="Sensor Contact not supported" />
            <Enumeration key="1" value="Sensor Contact not supported" />
            <Enumeration key="2" value="Sensor Contact supported, contact not detected" />
            <Enumeration key="3" value="Sensor Contact supported, contact detected" />
          </Enumerations>
        </Bit>
        <Bit index="3" size="1" name="Energy Expended Status bit">
          <Enumerations>
            <Enumeration key="0" value="Energy Expended field not present" />
            <Enumeration key="1" value="Energy Expended field present" requires="C3" />
          </Enumerations>
        </Bit>
        <Bit index="4" size="1" name="RR-Interval bit">
          <Enumerations>
            <Enumeration key="0" value="RR-Interval values not present" />
            <Enumeration key="1" value="One or more RR-Interval values present" requires="C4" />
          </Enumerations>
        </Bit>
        <ReservedForFutureUse index="5" size="3" />
      </BitField>
    </Field>
    <Field name="Heart Rate Measurement Value (uint8)">
      <Requirement>C1</Requirement>
      <Format>uint8</Format>
      <Unit>org.bluetooth.unit.period.beats_per_minute</Unit>
    </Field>
    <Field name="Heart Rate Measurement Value (uint16)">
      <Requirement>C2</Requirement>
      <Format>uint16</Format>
      <Unit>org.bluetooth.unit.period.beats_per_minute</Unit>
    </Field>
    <Field name="Energy Expended">
      <InformativeText>Present when bit 3 of the Flags field is set.</InformativeText>
      <Requirement>C3</Requirement>
      <Format>uint16</Format>
      <Unit>org.bluetooth.unit.energy.joule</Unit>
    </Field>
    <Field name="RR-Interval">
      <Requirement>C4</Requirement>
      <Format>uint16</Format>
      <Unit>org.bluetooth.unit.time.second</Unit>
      <BinaryExponent>-10</BinaryExponent>
      <Description>Resolution of 1/1024 second</Description>
      <Repeated>true</Repeated>
    </Field>
  </Value>
</Characteristic>
