<?xml version="1.0" encoding="UTF-8"?>
<!-- Representative conditional GATT characteristic whose value varies by a leading discriminator byte
     (hand-authored fixture; the <Variants> form is a simplification of the SIG's flag/bit-field conditionals). -->
<Characteristic name="Sensor Reading" type="org.bluetooth.characteristic.sensor_reading" uuid="2BCF">
    <Value>
        <Variants discriminator="Type">
            <Variant name="Temperature" value="1">
                <Field name="Temperature">
                    <Format>sint16</Format>
                    <DecimalExponent>-2</DecimalExponent>
                </Field>
            </Variant>
            <Variant name="Humidity" value="2">
                <Field name="Humidity">
                    <Format>uint16</Format>
                    <DecimalExponent>-2</DecimalExponent>
                </Field>
            </Variant>
        </Variants>
    </Value>
</Characteristic>
